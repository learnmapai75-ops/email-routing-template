{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "email-routing-template",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"upload_source_maps": true,
	"assets": {
		"binding": "ASSETS",
		"directory": "./public",
		"run_worker_first": ["/"]
	},
	"vars": {
		"ROUTE_ADDRESS": "support@learn-map.in",
		"FORWARD_TO": "learnmapai75@gmail.com",
		"ALLOWED_SENDERS": "admin.learn-map.in, learnmapai75@gmail.com, ranjeet.tiwary@learn-map.in, *"
	},
	// Email Routing rules for support@learn-map.in and admin@learn-map.in are managed and bound to this worker in Cloudflare.
	"observability": {
		"enabled": true
	}
}
